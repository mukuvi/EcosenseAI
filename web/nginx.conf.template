# Rendered by the nginx image entrypoint: PORT and BACKEND_URL are substituted
# from the environment. nginx's own variables ($uri, $host, ...) are left alone
# because the entrypoint only substitutes defined env vars.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Report photos are capped at 10 MB in the API; leave headroom for
    # multipart overhead or nginx rejects uploads before Express sees them.
    client_max_body_size 12m;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Classification can be slow on a 512 MB instance.
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite emits hashed filenames; cache them hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
